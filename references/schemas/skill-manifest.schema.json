{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tidyfactor.dev/schemas/skill-manifest.schema.json",
  "title": "TidyFactor Skill Manifest — Unified Tools & Decision Gates Schema (v1.1.0)",
  "description": "Defines the authoritative runtime manifest for a TidyFactor skill, covering both runtime-executable tools (scripts/) and Contextual Decision Layer gates (decision_gates[]). Consumed by AI agents for deterministic CLI/workflow execution and by tidyfactor-brain for governance and tool dispatching.",
  "type": "object",
  "required": ["manifest_schema_version", "skill_id", "skill_root_anchor"],
  "properties": {
    "manifest_schema_version": {
      "type": "string",
      "enum": ["1.0.0", "1.1.0"],
      "description": "Version of this manifest schema (1.1.0 includes decision_gates)."
    },
    "skill_id": {
      "type": "string",
      "pattern": "^tidyfactor-[a-z0-9-]+$",
      "description": "Must match the skill directory name / SKILL.md id, e.g. 'tidyfactor-design'."
    },
    "skill_root_anchor": {
      "type": "string",
      "const": "self",
      "description": "Fixed convention: skill_root is ALWAYS the directory containing manifest.json."
    },
    "tools": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/tool" },
      "description": "Runtime-executable capabilities in scripts/."
    },
    "decision_gates": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/decision_gate" },
      "description": "Contextual Decision Layer gates declaring required decisions, discovery sources, local persistence targets, and recommended defaults."
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "required": [
        "name",
        "description",
        "entrypoint",
        "invocation",
        "output",
        "runtime_requirements",
        "invoked_by_commands"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Unique id within this skill, e.g. 'audit_design'."
        },
        "description": {
          "type": "string",
          "maxLength": 200,
          "description": "One sentence, agent-facing description."
        },
        "entrypoint": {
          "type": "object",
          "required": ["runtime", "script"],
          "properties": {
            "runtime": { "type": "string", "enum": ["python3", "node"] },
            "script": {
              "type": "string",
              "description": "Path relative to skill_root, e.g. 'scripts/audit_design.py'."
            }
          }
        },
        "invocation": {
          "type": "object",
          "required": ["cli_pattern", "args"],
          "properties": {
            "cli_pattern": {
              "type": "string",
              "description": "Template: {runtime} {skill_root} {script} {target_path} {flags}."
            },
            "args": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "type", "required"],
                "properties": {
                  "name": { "type": "string" },
                  "type": { "type": "string", "enum": ["path", "string", "boolean", "number"] },
                  "required": { "type": "boolean" },
                  "default": {},
                  "flag": { "type": "string", "description": "CLI flag, e.g. '--fix'." },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        "output": {
          "type": "object",
          "required": ["format", "channel"],
          "properties": {
            "format": { "type": "string", "enum": ["json", "text"] },
            "channel": { "type": "string", "enum": ["stdout", "file"] },
            "schema_ref": {
              "type": "string",
              "description": "Optional relative path to output JSON Schema."
            }
          }
        },
        "runtime_requirements": {
          "type": "object",
          "required": ["isolation_recommended", "dependencies"],
          "properties": {
            "isolation_recommended": { "type": "boolean" },
            "dependencies": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "invoked_by_commands": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "decision_gate": {
      "type": "object",
      "required": ["command", "description", "decisions"],
      "properties": {
        "command": {
          "type": "string",
          "description": "Command name this gate executes before, e.g. 'brief'."
        },
        "description": { "type": "string" },
        "max_interactive_questions": {
          "type": "integer",
          "minimum": 1,
          "description": "Optional soft limit or batch size for interactive questions."
        },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/decision" }
        }
      }
    },
    "decision": {
      "type": "object",
      "required": ["key", "description", "type", "default", "discovery", "persist_to"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Unique id within this gate, e.g. 'audience_mode'."
        },
        "description": {
          "type": "string",
          "description": "The decision question or parameter description."
        },
        "type": { "type": "string", "enum": ["enum", "string", "boolean", "number", "array"] },
        "options": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Recommended for enum types."
        },
        "default": {
          "description": "Recommended default or fallback value."
        },
        "priority": {
          "type": "integer",
          "description": "Display and resolution priority (1 = highest)."
        },
        "discovery": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["source"],
            "properties": {
              "source": {
                "type": "string",
                "enum": ["local_file", "brain_ki", "workspace_scan", "cli_flag", "open_tabs"]
              },
              "path": {
                "type": "string",
                "description": "Path relative to project root."
              },
              "field": { "type": "string" },
              "json_path": { "type": "string" },
              "ki_type": { "type": "string" },
              "track_staleness": {
                "type": "boolean",
                "default": false,
                "description": "If true, track file hash/mtime locally to detect workspace drift without network calls."
              }
            }
          }
        },
        "persist_to": {
          "type": "object",
          "required": ["local"],
          "properties": {
            "local": {
              "type": "object",
              "required": ["path"],
              "properties": {
                "path": {
                  "type": "string",
                  "description": "Relative path to local brief or snapshot, e.g. '.tidyfactor/design-brief.snapshot.json'."
                },
                "field": { "type": "string" }
              }
            },
            "brain_ki": {
              "type": "object",
              "required": ["sync_direction"],
              "properties": {
                "sync_direction": {
                  "type": "string",
                  "const": "outbound_push_only",
                  "description": "Cloud sync MUST be outbound push only via explicit flag (Anti-Dual-Write doctrine)."
                },
                "requires_flag": {
                  "type": "string",
                  "default": "--sync-brain"
                }
              }
            }
          }
        }
      }
    }
  }
}
